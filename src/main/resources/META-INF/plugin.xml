<idea-plugin>
    <id>com.fishnovel.idea</id>
    <name>FishNovel</name>
    <vendor url="https://gitee.com/qyy114/fish-novelFishNovel">FishNovel</vendor>
    <resource-bundle>messages.FishNovelBundle</resource-bundle>

    <description><![CDATA[
        FishNovel turns IntelliJ IDEA into a lightweight novel reader with local multi-format support,
        reading progress memory, bookmarks, history, and web novel reading.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.fishnovel.idea.service.ReadingStateService"/>
        <projectService serviceImplementation="com.fishnovel.idea.service.FishNovelProjectService"/>
        <toolWindow factoryClass="com.fishnovel.idea.ui.FishNovelToolWindowFactory"
                    id="FishNovel"
                    anchor="right"
                    icon="/META-INF/pluginIcon.svg"/>
    </extensions>

    <actions>
        <action id="FishNovel.OpenToolWindowAction"
                class="com.fishnovel.idea.action.OpenFishNovelToolWindowAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
