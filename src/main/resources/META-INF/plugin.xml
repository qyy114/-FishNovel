<idea-plugin>
    <id>com.fishnovel.idea</id>
    <name>FishNovel</name>
    <vendor email="support@fishnovel.local" url="https://gitee.com/">FishNovel</vendor>

    <description><![CDATA[
        FishNovel turns IntelliJ IDEA into a discreet novel reader with local multi-format support,
        reading progress memory, bookmarks, history, and web novel reading.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.fishnovel.idea.service.ReadingStateService"/>
        <projectService serviceImplementation="com.fishnovel.idea.service.FishNovelProjectService"/>
        <toolWindow factoryClass="com.fishnovel.idea.ui.FishNovelToolWindowFactory"
                    id="FishNovel"
                    anchor="right"
                    icon="/META-INF/pluginIcon.svg"/>
    </extensions>

    <actions>
        <action id="FishNovel.OpenToolWindowAction"
                class="com.fishnovel.idea.action.OpenFishNovelToolWindowAction"
                text="打开 FishNovel"
                description="打开 FishNovel 阅读工具窗口">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
